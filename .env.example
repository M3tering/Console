# Server Configuration
PORT=3000
# Listen on LAN interfaces as well as localhost.
CONSOLE_HOST=0.0.0.0


# Module Configuration
BACKEND_MODULES="core/arweave,core/is_on,core/prover,core/streamr"
UI_MODULES="streamr:core/streamr/ui"

# ChirpStack Configuration
API_TOKEN=...
APPLICATION_ID=...
CHIRPSTACK_HOST=localhost
# Optional web UI origin; defaults to http://CHIRPSTACK_HOST:8080.
# Browsers access it through the console's /chirpstack/ proxy.
# CHEFSTACK_URL=http://localhost:8080
# CHIRPSTACK_WEB_URL remains supported; CHEFSTACK_URL takes precedence.
# CHIRPSTACK_WEB_URL=http://localhost:8080
# Optional broker URL (mqtt/mqtts/ws/wss).
# When absent, preserve CHIRPSTACK_HOST on port 1883, default localhost.
# MQTT_URL=mqtt://localhost:1883

# Contract & Network Configuration
CONTRACT_LABEL=M3ters
MAINNET_RPC=https://ethereum-sepolia-rpc.publicnode.com  #alt https://eth-sepolia.g.alchemy.com/v2/<YOUR_API_KEY>
ETHEREUM_PRIVATE_KEY="..."
ROLLUP_CONTRACT_ADDRESS="0x9a9ED9b9A9BEC10d1B5E41b1873E78d19501D5Fa"

# Streamr Configuration
STREAMR_STREAM_ID="0x567853282663b601bfdb9203819b1fbb3fe18926/m3tering/test"
STREAMR_CRONSCHEDULE="0 * * * *"  # Every hour

# Optional: Prover Node (disabled publishing to prover if not set)
# PREFERRED_PROVER_NODE="https://prover.m3ter.ing"
# PROVER_CRONSCHEDULE="0 0 * * *" # Every 24 hours

# Centralized Console feature branch — opt-in configuration contract.
# See docs/centralized/deployment.md and its test/release gates before opting in.
# Existing installations remain standalone.
# CONSOLE_ROLE=standalone
# CENTRAL_URL=wss://console.example.invalid
# AGENT_CREDENTIAL_PATH=/opt/app/.data/agent/credential
# FALLBACK_SECRET_PATH=/opt/app/.data/agent/fallback-secret
# CENTRAL_DECISION_TIMEOUT_MS=8000
# CENTRAL_RECOVERY_HEALTHY_MS=15000
# AGENT_QUEUE_LIMIT=10000
# Never enable this outside isolated development fixtures.
# CENTRAL_ALLOW_INSECURE_DEVELOPMENT=false
# Only explicit reverse-proxy peer IPs; forwarded headers are otherwise ignored.
# CENTRAL_TRUSTED_PROXIES=127.0.0.1,::1
# One-time token from central enrollment; remove it after the credential file exists.
# AGENT_ENROLLMENT_TOKEN=REPLACE_WITH_ONE_TIME_TOKEN
# Central bootstrap only; password must have at least 7 characters.
# CENTRAL_ADMIN_USERNAME=admin
# CENTRAL_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_LONG_PASSWORD
# Loopback authenticated fallback. Never publish this port through a proxy.
# GATEWAY_FALLBACK_PORT=3011  (not 3001: ChirpStack's Basic Station bridge uses it)
# Gateway-owned tunnel policy; central cannot override these targets.
# AGENT_SSH_PORT=22
# AGENT_BROWSER_ALLOW_LAN=false
# AGENT_BROWSER_PORTS=80,443,3000,8080,8090
# Used only by compose.central.yaml's TLS proxy.
# CENTRAL_DOMAIN=console.example.invalid
# Central with no gateway selected: ChirpStack opens this dashboard (an origin, no path),
# and Terminal signs in to this server's own SSH (password login) on CENTRAL_SSH_PORT.
# CENTRAL_CHIRPSTACK_URL=https://chirpstack.example.invalid
# CENTRAL_SSH_PORT=22

# Images are not configured here. ./auto-compose.sh uses ghcr.io/<owner>/<repo> from this
# checkout's GitHub origin remote (plus -updater / -browser); pin a build with --image.
# Optional browser engine path inside the browser image.
# BROWSER_EXECUTABLE=/usr/bin/chromium

# Optional signed updater on gateways; ./auto-compose.sh starts it when this is true and
# trusts only images signed by this checkout's repository. Never mount Docker in agent.
# REMOTE_UPDATES_ENABLED=false
# UPDATER_ALLOWED_REFS=refs/heads/main
# UPDATER_RECONNECT_TIMEOUT_MS=180000
# Registry/API access token for gh verification, only in the updater container.
# UPDATER_GITHUB_TOKEN=REPLACE_WITH_READ_ONLY_VERIFICATION_TOKEN
